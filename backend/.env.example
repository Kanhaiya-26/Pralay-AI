# Copy to backend/.env and adjust. PRALAY AI is free to run: no setting here enables a paid service.
# Any credentials are used server-side only and are never returned by the API or written to logs.

# --- Visual AI (optional, LOCAL and FREE) ----------------------------------------------
# PRALAY uses no paid or cloud AI. The only vision provider is a model running on THIS machine via Ollama
# (free, https://ollama.com). Images are only sent to loopback endpoints; nothing leaves the machine.
#   1. Install Ollama   2. ollama pull qwen2.5vl:3b   3. keep VISION_PROVIDER=ollama
# If Ollama is not running or the model is missing, analysis is recorded as unavailable and the rest of the
# pipeline continues. Any other provider name (e.g. a cloud service) is rejected and treated as "none".
VISION_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
# qwen2.5vl:3b (default; best for 8 GB RAM / CPU-only) or gemma3:4b
OLLAMA_MODEL=qwen2.5vl:3b
# CPU-only inference is slow; generous timeout
OLLAMA_TIMEOUT_SEC=240
# deferred = reports finish immediately, AI observations are added afterwards (recommended on CPU)
# inline   = analyse during processing (slower reports)
VISION_MODE=deferred
# Images are downscaled to this longest edge before analysis (speed); originals are untouched
VISION_MAX_EDGE=1024
# Allow an Ollama host on your private LAN (never the public internet). Default: loopback only.
VISION_ALLOW_LAN=false
# Unload the model this long after the last analysis (frees ~3 GB RAM sooner than Ollama's 5 min default)
OLLAMA_KEEP_ALIVE=60s
# Deferred analysis waits while available RAM is below this (protects 8 GB laptops from swapping)
VISION_MIN_FREE_MB=600

# --- External evidence ------------------------------------------------------------------
# false = fully offline demo (external evidence is then recorded as "unavailable").
EXTERNAL_LOOKUPS=true
HTTP_TIMEOUT=12

# --- Social-media connectors (authorised / documented public APIs only; no scraping) ----
# Mastodon public tag timelines need no credentials. Off unless run from the UI or polled:
MASTODON_INSTANCE=https://mastodon.social
MASTODON_TAGS=flood,floods,landslide,cyclone,waterlogging
MASTODON_POLL_MIN=0
MASTODON_REQUIRE_INDIA=true
MASTODON_MAX_AGE_DAYS=7
# Registered but not implemented; they stay NOT_CONFIGURED. X's API needs a paid tier, so it is excluded by the
# free-only policy. YouTube Data API and Bluesky have free access tiers (adapters not built yet).
X_BEARER_TOKEN=
YOUTUBE_API_KEY=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# --- Disaster control grid -------------------------------------------------------------
# regular = CUSTOM / DEMO lat/lon grid (NOT an official IMD/NDMA grid).
# geojson = load cells from GRID_GEOJSON_PATH (FeatureCollection of Polygons with a "cell_id" property).
#           PRALAY cannot verify a file's provenance and never labels it official.
GRID_PROVIDER=regular
GRID_RESOLUTION_DEG=0.25
GRID_GEOJSON_PATH=

# --- Incident clustering ----------------------------------------------------------------
CLUSTER_RADIUS_KM=12
CLUSTER_TIME_WINDOW_H=72
ACTIVE_INCIDENT_WINDOW_H=48

# --- Freshness / monitoring ------------------------------------------------------------
EVIDENCE_TTL_ACTIVE_MIN=20
EVIDENCE_TTL_OLD_MIN=360
QUERY_CACHE_TTL_MIN=15
MONITOR_INTERVAL_SEC=120

MAX_UPLOAD_MB=25
# PRALAY_DATA_DIR=./data
# PRALAY_TEST_MODE=1   (test runner only: enables /api/test/simulate-failure; never set in production)
